{
  "name": "course_flow_v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "nub run catalog:autocomplete && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "nub run catalog:offerings:prod && nub run build && nub exec wrangler deploy",
    "deploy:dry-run": "nub run catalog:offerings:prod && nub run build && nub exec wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "d1:info": "wrangler d1 info course-flow-v4",
    "d1:migrate:local": "wrangler d1 migrations apply course-flow-v4 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply course-flow-v4 --remote",
    "d1:migrate:prod": "nub run d1:migrate:remote",
    "d1:backup:prod": "mkdir -p .wrangler/backups && wrangler d1 export course-flow-v4 --remote --output .wrangler/backups/course-flow-v4.sql",
    "d1:seed:csc": "node scripts/seed-csc.mjs --local",
    "d1:seed:csc:local": "node scripts/seed-csc.mjs --local",
    "d1:seed:csc:remote": "node scripts/seed-csc.mjs --remote",
    "d1:seed:csc:prod": "nub run d1:seed:csc:remote",
    "catalog:import": "node scripts/import-catalog.ts --courses data/import/courses.json",
    "catalog:import:local": "nub run catalog:import -- --target local",
    "catalog:import:prod": "nub run catalog:import -- --target remote",
    "catalog:autocomplete": "node scripts/generate-course-autocomplete.ts",
    "catalog:offerings": "node scripts/generate-course-offerings.ts",
    "catalog:offerings:local": "nub run catalog:offerings -- --target local",
    "catalog:offerings:prod": "nub run catalog:offerings -- --target remote",
    "catalog:embed": "node scripts/generate-course-embeddings.ts",
    "catalog:embed:local": "nub run catalog:embed -- --target local",
    "catalog:embed:prod": "nub run catalog:embed -- --target remote",
    "typecheck": "tsc --noEmit",
    "install:frozen": "nub ci",
    "deps:outdated": "nub outdated",
    "deps:audit": "nub audit",
    "deps:update": "nub update --latest --exact"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.42.1",
    "@fontsource-variable/geist": "5.2.9",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-devtools": "0.10.7",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.168.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.0",
    "@tanstack/router-cli": "1.167.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "wrangler": "4.103.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "npm@11.12.1"
}
