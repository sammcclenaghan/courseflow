{
  "name": "courseflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "catalog:fetch": "node catalog/fetch.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.3",
    "hono": "4.13.13",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vite-plugin": "1.63.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lightningcss": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.5",
      "onFail": "ignore"
    }
  }
}
