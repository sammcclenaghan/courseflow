{
  "name": "course_flow_v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "catalog:fetch": "node scripts/fetch.ts",
    "catalog:build": "node scripts/build.ts",
    "d1:migrate:local": "wrangler d1 migrations apply course-flow-v4 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply course-flow-v4 --remote",
    "d1:backup:prod": "mkdir -p .wrangler/backups && wrangler d1 export course-flow-v4 --remote --output .wrangler/backups/course-flow-v4.sql",
    "install:frozen": "nub ci",
    "deps:outdated": "nub outdated",
    "deps:audit": "nub audit",
    "deps:update": "nub update --latest --exact"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.0",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild": true,
    "lightningcss": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.5",
      "onFail": "ignore"
    }
  }
}
