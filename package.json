{
  "name": "course_flow_v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "catalog:fetch": "node scripts/fetch.ts",
    "catalog:build": "node scripts/build.ts",
    "d1:migrate:local": "wrangler d1 migrations apply course-flow-v4 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply course-flow-v4 --remote",
    "d1:backup:prod": "mkdir -p .wrangler/backups && wrangler d1 export course-flow-v4 --remote --output .wrangler/backups/course-flow-v4.sql",
    "install:frozen": "nub ci",
    "deps:outdated": "nub outdated",
    "deps:audit": "nub audit",
    "deps:update": "nub update --latest --exact"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "hono": "4.13.13",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vite-plugin": "1.63.1",
    "@preact/preset-vite": "2.10.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.0",
    "jsdom": "28.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild": true,
    "lightningcss": true
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.5",
      "onFail": "ignore"
    }
  }
}
