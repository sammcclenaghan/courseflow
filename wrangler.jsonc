{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "course-flow-v4",
  "compatibility_date": "2026-06-23",
  "main": "worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    // Everything else is a static file; only the API reaches the worker.
    "run_worker_first": ["/api/*"],
  },
  // Empty rather than omitted: without the key, deploys keep existing crons.
  "triggers": {
    "crons": [],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
